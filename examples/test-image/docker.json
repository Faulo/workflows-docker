{
  "schemaVersion": 3,
  "namespace": "$DOCKER_NAMESPACE",
  "image": "$DOCKER_IMAGE",
  "envFile": "examples/test-image/.env",
  "context": "examples/test-image",
  "buildArgs": {
    "SHARED_MESSAGE": "$FIXTURE_MESSAGE"
  },
  "timeoutMinutes": 30,
  "matrix": {
    "version": {
      "buildArgs": {
        "VARIANT": "{{matrix.version}}"
      },
      "tags": {
        "1.0": {},
        "2.0": {}
      }
    },
    "os": {
      "dockerfile": "examples/test-image/{{matrix.os}}/Dockerfile",
      "buildArgs": {
        "TARGET_ID": "{{matrix.os}}-{{matrix.target}}"
      },
      "tags": {
        "linux": {
          "matrix": {
            "target": {
              "tags": {
                "amd64": {
                  "runner": "ubuntu-latest"
                },
                "arm64": {
                  "runner": "ubuntu-24.04-arm"
                }
              }
            }
          }
        },
        "windows": {
          "runner": "windows-latest",
          "matrix": {
            "target": {
              "buildArgs": {
                "BASE_IMAGE": "mcr.microsoft.com/windows/nanoserver:ltsc{{matrix.target}}"
              },
              "tags": {
                "2019": {},
                "2022": {}
              }
            }
          }
        }
      }
    }
  }
}
