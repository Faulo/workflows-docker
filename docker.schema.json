{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docker publishing configuration v3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "namespace",
        "image",
        "variants"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\u0000]+$",
          "description": "Docker Hub repository name after environment substitution"
        },
        "context": {
          "$ref": "#/$defs/path"
        },
        "buildArgs": {
          "$ref": "#/$defs/arguments"
        },
        "targets": {
          "$ref": "#/$defs/targets"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "$ref": "#/$defs/tag"
              },
              "aliases": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/tag"
                }
              },
              "buildArgs": {
                "$ref": "#/$defs/arguments"
              },
              "targets": {
                "$ref": "#/$defs/targets"
              }
            }
          }
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\u0000]+$",
          "description": "Docker Hub namespace after environment substitution"
        },
        "envFile": {
          "$ref": "#/$defs/path",
          "description": "Caller-relative dotenv file; defaults to .env when present"
        },
        "description": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\r\\n\\u0000]*$",
          "description": "Optional Docker Hub short description; at most 100 UTF-8 bytes after environment substitution. Omit to preserve the existing value."
        },
        "overviewFile": {
          "$ref": "#/$defs/path",
          "description": "Optional UTF-8 Markdown file relative to the calling repository root. At most 25000 UTF-8 bytes after relative URL resolution. Omit to preserve the existing overview."
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "targets"
              ]
            }
          },
          "then": {
            "properties": {
              "variants": {
                "items": {
                  "required": [
                    "targets"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "namespace",
        "image",
        "matrix"
      ],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\u0000]+$",
          "description": "Docker Hub namespace after environment substitution"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\u0000]+$",
          "description": "Docker Hub repository name after environment substitution"
        },
        "envFile": {
          "$ref": "#/$defs/path",
          "description": "Caller-relative dotenv file; defaults to .env when present"
        },
        "context": {
          "$ref": "#/$defs/path"
        },
        "buildArgs": {
          "$ref": "#/$defs/arguments"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "dockerfile": {
          "$ref": "#/$defs/path"
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "matrix": {
          "$ref": "#/$defs/matrix"
        },
        "description": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\r\\n\\u0000]*$",
          "description": "Optional Docker Hub short description; at most 100 UTF-8 bytes after environment substitution. Omit to preserve the existing value."
        },
        "overviewFile": {
          "$ref": "#/$defs/path",
          "description": "Optional UTF-8 Markdown file relative to the calling repository root. At most 25000 UTF-8 bytes after relative URL resolution. Omit to preserve the existing overview."
        }
      }
    }
  ],
  "$defs": {
    "tag": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$",
      "maxLength": 128,
      "description": "Public Docker tag after environment substitution; wf-v3- prefix is reserved"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\-])(?!.*(?:^|/)\\.\\.(?:/|$))[^:\\\\\r\n\u0000]+$"
    },
    "arguments": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[^\r\n\u0000]*$"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "runner": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\r\n\u0000]+$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\r\n\u0000]+$"
          }
        }
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "runner",
          "dockerfile"
        ],
        "properties": {
          "tag": {
            "$ref": "#/$defs/tag",
            "description": "Unique target tag suffix within a variant, after environment substitution"
          },
          "runner": {
            "$ref": "#/$defs/runner"
          },
          "context": {
            "$ref": "#/$defs/path"
          },
          "dockerfile": {
            "$ref": "#/$defs/path"
          },
          "buildArgs": {
            "$ref": "#/$defs/arguments"
          },
          "timeoutMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 360
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/axis"
      },
      "description": "Axes multiply in declaration order; labels do not contribute to tags"
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tags"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/path"
        },
        "buildArgs": {
          "$ref": "#/$defs/arguments"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "dockerfile": {
          "$ref": "#/$defs/path"
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "tags": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/choice"
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/path"
        },
        "buildArgs": {
          "$ref": "#/$defs/arguments"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "dockerfile": {
          "$ref": "#/$defs/path"
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "matrix": {
          "$ref": "#/$defs/matrix"
        }
      }
    }
  }
}
