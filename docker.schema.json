{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docker publishing configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "namespace",
    "image",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$",
      "description": "Docker Hub repository name after environment substitution"
    },
    "context": {
      "$ref": "#/$defs/path"
    },
    "buildArgs": {
      "$ref": "#/$defs/arguments"
    },
    "targets": {
      "$ref": "#/$defs/targets"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag"
        ],
        "properties": {
          "tag": {
            "$ref": "#/$defs/tag"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/tag"
            }
          },
          "buildArgs": {
            "$ref": "#/$defs/arguments"
          },
          "targets": {
            "$ref": "#/$defs/targets"
          }
        }
      }
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$",
      "description": "Docker Hub namespace after environment substitution"
    },
    "envFile": {
      "$ref": "#/$defs/path",
      "description": "Caller-relative dotenv file; defaults to .env when present"
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "targets"
          ]
        }
      },
      "then": {
        "properties": {
          "variants": {
            "items": {
              "required": [
                "targets"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "tag": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$",
      "maxLength": 128,
      "description": "Public Docker tag after environment substitution; wf-v2- prefix is reserved"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\-])(?!.*(?:^|/)\\.\\.(?:/|$))[^:\\\\\r\n\u0000]+$"
    },
    "arguments": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[^\r\n\u0000]*$"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "runner": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\r\n\u0000]+$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\r\n\u0000]+$"
          }
        }
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "runner",
          "dockerfile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n\\u0000]+$",
            "description": "Unique lowercase target id after environment substitution"
          },
          "runner": {
            "$ref": "#/$defs/runner"
          },
          "context": {
            "$ref": "#/$defs/path"
          },
          "dockerfile": {
            "$ref": "#/$defs/path"
          },
          "buildArgs": {
            "$ref": "#/$defs/arguments"
          },
          "timeoutMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 360
          }
        }
      }
    }
  }
}
